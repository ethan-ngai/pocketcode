# Pocketcode production deployment configuration.
# Copy this file to .env for local handoff only. Do not commit real secrets.

# Required app origins. Usually both are the same production URL.
BETTER_AUTH_URL="https://example.com"
APP_BASE_URL="https://example.com"

# Required auth secret. Generate a strong random value for production.
BETTER_AUTH_SECRET="replace-with-strong-random-secret"

# Database. Prefer a Cloudflare Hyperdrive binding named HYPERDRIVE in wrangler.jsonc.
# Set DATABASE_URL only when Hyperdrive is not configured yet.
DATABASE_URL="postgres://user:password@host:5432/database?sslmode=require"

# Required SMS8 credentials and device route.
SMS8_API_KEY="replace-with-sms8-api-key"
SMS8_DEVICES='["182|0"]'

# Production webhook and pilot access policy.
ENVIRONMENT="production"
SMS8_WEBHOOK_AUTH_ENABLED="true"
SMS8_PRIORITIZE="0"
SMS_ALLOWLIST="+15555550123,+15555550124"

# Optional admin/auth settings.
ADMIN_EMAILS="admin@example.com,ops@example.com"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Optional execution limits. Defaults are 5000 and 4000 when unset.
EXECUTION_TIMEOUT_MS="5000"
EXECUTION_MAX_OUTPUT_CHARS="4000"
